{
  "$schema": "../../../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for simple.pdf main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "os:default"
  ]
}
